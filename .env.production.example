# Settings for docker-compose.yml. Copy to .env.production (or .env.preprod) and fill in every value.
# Both files are gitignored. Wrap any value containing "$" in single quotes.
#   docker compose -p shopos-prod --env-file .env.production up -d --build --wait

# --- Address --------------------------------------------------------------------------------
# Hostname the site is served on. A LAN name/IP or localhost with SHOPOS_TLS=internal, or a public
# domain pointing at this machine with SHOPOS_TLS=<your email> for a Let's Encrypt certificate.
SHOPOS_DOMAIN=localhost
SHOPOS_TLS=internal
SHOPOS_HTTP_PORT=80
SHOPOS_HTTPS_PORT=443
# The address people type, used in email links. Include the port if it is not 443.
SHOPOS_PUBLIC_URL=https://localhost
# Send HSTS only once a trusted certificate is in place, e.g. 'max-age=31536000'.
SHOPOS_HSTS=max-age=0

# --- Email (sign-up confirmation, password reset, staff invitations) ----------------------------
# Without a mail provider: keep COMPOSE_PROFILES=mailpit and SHOPOS_SMTP_HOST=mailpit. Emails then land
# in a local inbox at http://localhost:<SHOPOS_MAILPIT_UI_PORT> instead of being delivered.
# With a provider (Gmail/Workspace, Brevo, SendGrid, Amazon SES, ...): remove COMPOSE_PROFILES and set
# the SMTP values it gives you, e.g. host smtp-relay.brevo.com, port 587, secure false.
COMPOSE_PROFILES=mailpit
SHOPOS_MAILPIT_UI_PORT=8025
SHOPOS_SMTP_HOST=mailpit
SHOPOS_SMTP_PORT=1025
SHOPOS_SMTP_SECURE=false
SHOPOS_SMTP_USER=
SHOPOS_SMTP_PASSWORD=
SHOPOS_MAIL_FROM='ShopOS <no-reply@shopos.local>'

# --- Database ---------------------------------------------------------------------------------
# Long random passwords. The app connects as SHOPOS_DB_USER, never as root.
SHOPOS_DB_NAME=shopos
SHOPOS_DB_USER=shopos
SHOPOS_DB_PASSWORD=change-me
SHOPOS_DB_ROOT_PASSWORD=change-me-too
SHOPOS_DB_BUFFER_POOL=256M

# --- File storage (product photos, payment proofs) ----------------------------------------------
# MinIO runs in the stack with these as its admin login; the app creates its bucket on first use.
# Long random values. Web console: http://localhost:<SHOPOS_MINIO_CONSOLE_PORT> (this machine only).
SHOPOS_S3_ACCESS_KEY=shopos
SHOPOS_S3_SECRET_KEY=change-me-three
SHOPOS_MINIO_CONSOLE_PORT=9001
# To use AWS S3 or Cloudflare R2 instead, set the endpoint, region and bucket too
# (and the keys above to that provider's), e.g. https://<account>.r2.cloudflarestorage.com, auto.
SHOPOS_S3_ENDPOINT=
SHOPOS_S3_REGION=
SHOPOS_S3_BUCKET=

# --- Backups ----------------------------------------------------------------------------------
# One compressed dump per interval, kept for this many days, in this host folder.
SHOPOS_BACKUP_DIR=./backups/production
SHOPOS_BACKUP_INTERVAL_SECONDS=86400
SHOPOS_BACKUP_KEEP_DAYS=14

# --- Shops and billing ------------------------------------------------------------------------
# New shop signups allowed per IP address per hour.
SHOPOS_SIGNUP_LIMIT=10
# Where shops send subscription payments; shown on their Billing page. Empty uses the built-in defaults.
SHOPOS_PAY_BANK_NAME=
SHOPOS_PAY_ACCOUNT_TITLE=
SHOPOS_PAY_ACCOUNT_NUMBER=
SHOPOS_PAY_IBAN=
# JazzCash / EasyPaisa number, and the WhatsApp number (with country code, e.g. 923001234567).
SHOPOS_PAY_WALLET=
SHOPOS_PAY_WHATSAPP=

# --- WhatsApp day-end reports (optional; see DEPLOYMENT.md) ----------------------------------
SHOPOS_WHATSAPP_TOKEN=
SHOPOS_WHATSAPP_PHONE_ID=
SHOPOS_WHATSAPP_TEMPLATE=daily_report
SHOPOS_WHATSAPP_LANG=en

# --- Other ------------------------------------------------------------------------------------
# Server time zone (logs, backups). Each shop sets its own zone for "today" in Settings.
SHOPOS_TZ=Asia/Karachi
# Image tag for the app build, e.g. a git commit or release number.
SHOPOS_VERSION=production
SHOPOS_APP_MEMORY=768m
