# Throwaway settings for running the e2e suite against the deployment stack (scripts/e2e.ps1 -Target preprod).
# Test-only credentials; never reuse them for a real environment.
SHOPOS_DOMAIN=nginx
SHOPOS_TLS=internal
SHOPOS_HSTS=max-age=0
SHOPOS_HTTP_PORT=18080
SHOPOS_HTTPS_PORT=18443
SHOPOS_PUBLIC_URL=https://nginx:18443
COMPOSE_PROFILES=mailpit
SHOPOS_MAILPIT_UI_PORT=18025
SHOPOS_SMTP_HOST=mailpit
SHOPOS_SMTP_PORT=1025
SHOPOS_MAIL_FROM='ShopOS E2E <e2e@shopos.local>'
SHOPOS_DB_PASSWORD=e2e-db-password
SHOPOS_DB_ROOT_PASSWORD=e2e-root-password
SHOPOS_BACKUP_DIR=./.e2e-backups
SHOPOS_BACKUP_INTERVAL_SECONDS=86400
SHOPOS_VERSION=e2e-stack
# Many test shops sign up from one container.
SHOPOS_SIGNUP_LIMIT=1000
SHOPOS_S3_ACCESS_KEY=shopos-e2e
SHOPOS_S3_SECRET_KEY=e2e-minio-password
SHOPOS_MINIO_CONSOLE_PORT=19001
# Sample payment details for the Billing page (clearly not a real account).
SHOPOS_PAY_BANK_NAME=Meezan Bank
SHOPOS_PAY_ACCOUNT_TITLE=ShopOS Test
SHOPOS_PAY_ACCOUNT_NUMBER=0000-1111222233
SHOPOS_PAY_IBAN=PK00TEST0000111122223333
SHOPOS_PAY_WALLET=03000000000
SHOPOS_PAY_WHATSAPP=923000000000
# Card billing with test-only values: the suite signs its own webhooks with this secret.
SHOPOS_PADDLE_ENV=sandbox
SHOPOS_PADDLE_CLIENT_TOKEN=test_e2e_client_token
SHOPOS_PADDLE_WEBHOOK_SECRET=e2e-paddle-webhook-secret
SHOPOS_PADDLE_PRICE_STARTER_MONTH=pri_e2e_starter_month
SHOPOS_PADDLE_PRICE_STARTER_YEAR=pri_e2e_starter_year
SHOPOS_PADDLE_PRICE_GROWTH_MONTH=pri_e2e_growth_month
SHOPOS_PADDLE_PRICE_GROWTH_YEAR=pri_e2e_growth_year
SHOPOS_PADDLE_TRIAL_PRICE_STARTER_MONTH=pri_e2e_trial_starter_month
SHOPOS_PADDLE_TRIAL_PRICE_STARTER_YEAR=pri_e2e_trial_starter_year
SHOPOS_PADDLE_TRIAL_PRICE_GROWTH_MONTH=pri_e2e_trial_growth_month
SHOPOS_PADDLE_TRIAL_PRICE_GROWTH_YEAR=pri_e2e_trial_growth_year
# The suite signs in far faster than people do (a CI runner, very fast); production keeps 30r/m.
SHOPOS_AUTH_RATE=600r/m
